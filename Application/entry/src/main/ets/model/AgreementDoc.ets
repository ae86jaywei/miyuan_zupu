    new AgreementSection('十一、联系我们', '运营者：' + OPERATOR_NAME + '\n联系邮箱：' + CONTACT_EMAIL + '\n\n' +
      '更新日期：' + D + '\n生效日期：' + D
    ),
  ];
  return doc;
}

/** 按类型取协议文档 */
export function agreementDocOf(type: string): AgreementDoc {
  return type === 'user' ? userAgreementDoc() : privacyPolicyDoc();
}
