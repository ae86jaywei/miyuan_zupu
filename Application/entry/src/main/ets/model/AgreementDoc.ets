/**
 * 法律文本：用户协议 / 隐私政策。
 *
 * 说明：文本集中维护在本文件，便于随版本更新同步修改；
 * 上架应用市场时提交的在线协议内容需与本文件保持一致。
 */

/** 运营者名称（如需替换为公司/个人真实主体，仅改此处） */
export const OPERATOR_NAME: string = '韦榕明';
/** 联系邮箱（应用市场隐私政策必须提供有效联系方式） */
export const CONTACT_EMAIL: string = '236056971@163.com';
/** 应用名称 */
export const APP_NAME: string = '觅源';
/** 协议版本与生效时间，更新协议时同步修改 */
export const AGREEMENT_VERSION: string = '1.0';
export const AGREEMENT_UPDATED_AT: string = '2026年11月8日';

/** 协议页面路由参数 */
export class AgreementParams {
  /** user = 用户协议；privacy = 隐私政策 */
  type: string = 'privacy';
}

/** 协议中的一个章节 */
export class AgreementSection {
  heading: string = '';
  body: string = '';

  constructor(heading: string, body: string) {
    this.heading = heading;
    this.body = body;
  }
}

/** 一篇协议文档 */
export class AgreementDoc {
  title: string = '';
  intro: string = '';
  sections: AgreementSection[] = [];
}

const D = AGREEMENT_UPDATED_AT;

/** 隐私政策 */
export function privacyPolicyDoc(): AgreementDoc {
  const doc: AgreementDoc = new AgreementDoc();
  doc.title = '隐私政策';
  doc.intro = APP_NAME + '（以下简称“本应用”）由' + OPERATOR_NAME + '运营。我们深知个人信息对你的重要性，' +
    '并会严格遵守《中华人民共和国个人信息保护法》《网络安全法》《数据安全法》等法律法规，' +
    '按照本政策收集、使用、存储和保护你的个人信息。请在使用本应用前仔细阅读并充分理解本政策。';
  doc.sections = [
    new AgreementSection('一、我们收集的个人信息', '我们仅收集实现族谱记录与家族协作所必需的信息，具体如下：\n' +
      '1. 账号信息：你使用华为账号登录时，我们获取华为账号的 UnionID、OpenID 及登录票据，用于生成应用内账号标识（hw-{UnionID}）；' +
      '我们不获取你的手机号、通讯录、短信内容。\n' +
      '2. 族谱内容：你主动录入或导入的族人信息，包括姓名、性别、生卒日期、世代、亲属关系、字辈、堂号、郡望、籍贯、职业、' +
      '联系方式（手机号、微信号等）、个人简介、备注、族人唯一 ID 等。\n' +
      '3. 照片与视频：你主动选择上传的族人头像、家族相片与视频。\n' +
      '4. 地理位置：仅在你主动为祖墓标注位置时，读取当前定位以获得经纬度与海拔，用于“祭祖寻墓”展示；不后台持续定位。\n' +
      '5. 设备与日志信息：应用运行日志、崩溃信息、设备型号与系统版本，用于排查故障与保障服务稳定。\n' +
      '6. 本地存储：族谱数据库、导入导出文件、导出 PDF 均优先保存在本机；接入云家族后，上述族谱内容才会同步至云端。'),
    new AgreementSection('二、系统权限说明', '1. 网络（INTERNET）：用于华为账号登录、云家族同步、族谱黄页查询与地图底图加载。\n' +
      '2. 位置（LOCATION）：仅用于为祖墓拾取 GPS 经纬度与海拔，拒绝授权不影响其他功能。\n' +
      '3. 相册/媒体（MEDIA）：仅用于选择族人头像、家族相片与视频，拒绝授权不影响文字录入。\n' +
      '以上权限均在你主动触发对应功能时申请，你可以随时在系统设置中关闭。'),
    new AgreementSection('三、我们如何使用个人信息', '1. 提供族谱录入、检索、谱系图渲染、统计、导入导出与 PDF 打印服务；\n' +
      '2. 在接入云家族后，为家族成员提供协同补录、变更审核、数据同步与成员权限管理；\n' +
      '3. 保障账号与数据安全，识别异常登录与异常请求；\n' +
      '4. 排查崩溃与性能问题，持续优化产品体验；\n' +
      '5. 我们不会将你的个人信息用于广告精准推送，也不会出售你的个人信息。'),
    new AgreementSection('四、第三方服务与信息共享', '本应用集成以下华为官方服务，相关信息的处理同时适用华为对应的隐私政策：\n' +
      '1. 华为账号服务（Account Kit）：用于华为账号登录与账号标识获取；\n' +
      '2. AppGallery Connect 认证 / 云数据库 / 云存储：用于云端登录态校验、族谱数据与照片视频的加密存储与同步。\n' +
      '除以下情形外，我们不会向第三方共享你的个人信息：\n' +
      '（1）经你明确同意，在家族协作范围内向同一家族的成员展示族谱内容；\n' +
      '（2）族谱黄页由谱主主动上架后，按谱名/姓氏/地域向其他用户展示谱名与公开信息；\n' +
      '（3）依据法律法规、司法或行政机关的强制性要求。'),
    new AgreementSection('五、信息的存储与保护', '1. 存储地域：你的个人信息存储于中华人民共和国境内的华为云服务节点。\n' +
      '2. 传输安全：客户端与服务端之间采用 HTTPS/TLS 加密传输；云函数按登录身份进行鉴权，跨家族数据默认隔离。\n' +
      '3. 权限控制：家族内按谱主、编辑者、只读成员分级授权；涉及隐私字段（手机号、微信号等）默认加星号显示，' +
      '可开启公开模式进一步隐藏。\n' +
      '4. 保留期限：在你使用本应用期间保留；你删除族谱、退出登录并注销账号后，我们会在合理期限内删除或匿名化处理，' +
      '法律法规另有规定的除外。'),
    new AgreementSection('六、你的个人信息权利', '1. 查阅与复制：可在应用内查看族谱内容，并通过“导入 / 导出”导出 JSON、CSV、PDF 副本。\n' +
      '2. 更正与补充：可在族人详情页或编辑页修改本人及经授权管理的信息。\n' +
      '3. 删除：可删除单个族人、删除整部族谱；云家族内可申请谱主删除或更正。\n' +
      '4. 撤回同意：可在系统设置中关闭位置、相册权限，或在设置页退出登录；撤回同意不影响此前已完成的处理。\n' +
      '5. 注销与投诉：可通过下方邮箱联系我们，我们将在 15 个工作日内答复处理。'),
    new AgreementSection('七、未成年人保护', '本应用面向家族成员记录族谱，不主动面向未成年人单独提供服务。若你是未满 14 周岁的儿童，' +
      '请在监护人陪同下阅读本政策，并在监护人同意后使用；监护人可联系我们删除儿童个人信息。'),
    new AgreementSection('八、隐私政策的变更', '当服务内容、信息处理方式或法律要求发生变化时，我们会更新本政策并在应用内以弹窗或公告方式提示。' +
      '若你继续使用本应用，即表示同意更新后的政策；如不同意，可停止使用并删除相关数据。'),
    new AgreementSection('九、联系我们', '运营者：' + OPERATOR_NAME + '\n联系邮箱：' + CONTACT_EMAIL + '\n' +
      '我们会在收到你的请求后 15 个工作日内答复。\n\n更新日期：' + D + '\n生效日期：' + D
    ),
  ];
  return doc;
}

