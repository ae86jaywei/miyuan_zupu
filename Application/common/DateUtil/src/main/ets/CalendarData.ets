/** 某一农历年的月份结构 */
export interface LunarYearInfo {
  /** 闰月月份（0 = 无闰月） */
  leapMonth: number;
  /** 闰月天数（无闰月为 0） */
  leapDays: number;
  /** 正月~腊月天数（下标 0~11） */
  monthDays: number[];
  /** 全年总天数 */
  totalDays: number;
}

