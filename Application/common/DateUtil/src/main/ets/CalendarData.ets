/** 解析某农历年的月份结构；越界返回 null */
export function lunarYearInfo(year: number): LunarYearInfo | null {
  if (year < LUNAR_MIN_YEAR || year > LUNAR_MAX_YEAR) return null;
  const info: number = LUNAR_INFO[year - LUNAR_MIN_YEAR];
  const leapMonth: number = info & 0xf;
  const leapDays: number = leapMonth > 0 ? ((info & 0x10000) !== 0 ? 30 : 29) : 0;
  const monthDays: number[] = [];
  let total: number = 0;
  for (let m: number = 1; m <= 12; m++) {
    const d: number = (info & (0x10000 >> m)) !== 0 ? 30 : 29;
    monthDays.push(d);
    total += d;
  }
  total += leapDays;
  return { leapMonth: leapMonth, leapDays: leapDays, monthDays: monthDays, totalDays: total };
}

/** 历史年号 */
export interface EraInfo {
  /** 年号名，如 光绪 */
  name: string;
  /** 元年对应的公历年 */
  firstYear: number;
  /** 最后一年（含）；0 表示由下一个年号自动推算 */
  endYear: number;
  /** 朝代 / 政权，如 清、南宋、辽 */
  regime: string;
  /** 是否参与“公历年 → 年号”主链换算（地方政权不参与） */
  mainline: boolean;
  /** 在主链中的起始公历年（宋元交替等重叠情况与 firstYear 不同） */
  displayFrom: number;
}

function era(name: string, firstYear: number, regime: string, mainline: boolean, displayFrom: number,
  endYear: number): EraInfo {
  return {
    name: name, firstYear: firstYear, endYear: endYear, regime: regime,
    mainline: mainline, displayFrom: displayFrom
  };
}

