/** 年号最后一年（含）：主链按下一个年号的显示起点推算 */
export function eraEndYear(index: number): number {
  if (index < 0 || index >= ERA_LIST.length) return 0;
  const e: EraInfo = ERA_LIST[index];
  if (!e.mainline) return e.endYear > 0 ? e.endYear : 2100;
  let nextFrom: number = 2101;
  for (let i: number = 0; i < ERA_LIST.length; i++) {
    const o: EraInfo = ERA_LIST[i];
    if (o.mainline && o.displayFrom > e.displayFrom && o.displayFrom < nextFrom) {
      nextFrom = o.displayFrom;
    }
  }
  const auto: number = nextFrom - 1;
  if (e.endYear > 0 && e.endYear < auto) return e.endYear;
  return auto;
}

/** 某年号可选的纪年数 */
export function eraYearCount(index: number): number {
  if (index < 0 || index >= ERA_LIST.length) return 1;
  const start: number = ERA_LIST[index].firstYear;
  const max: number = Math.min(eraEndYear(index), 2100);
  return Math.max(max - start + 1, 1);
}

/** 年号选择器文案 */
export function eraLabel(index: number): string {
  const e: EraInfo = ERA_LIST[index];
  return e.name + '年（' + e.regime + '·' + e.firstYear.toString() + '起）';
}
