{
  "name": "grave-list-public",
  "version": "1.0.0",
  "description": "按关键字聚合祖墓（公开表端侧也可直读本函数非必需）",
  "handler": "index.handler",
  "memorySize": 500,
  "timeout": 30,
  "triggers": [
    {
      "type": "http",
      "properties": {
        "enableUrlDecode": true,
        "authFlag": "true",
        "authAlgor": "HDA-SYSTEM",
