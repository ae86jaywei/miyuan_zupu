{
  "name": "media-record",
  "version": "1.0.0",
  "description": "登记媒体索引（云存储路径必须属于该家族）",
  "handler": "index.handler",
  "memorySize": 500,
  "timeout": 30,
  "triggers": [
    {
      "type": "http",
      "properties": {
        "enableUrlDecode": true,
        "authFlag": "true",
        "authAlgor": "HDA-SYSTEM",
        "authType": "apigw-client",
        "methods": [
          "POST"
        ]
      }
    }
  ]
}
