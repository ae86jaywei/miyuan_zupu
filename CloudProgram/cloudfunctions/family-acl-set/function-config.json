{
  "name": "family-acl-set",
  "version": "1.0.0",
  "description": "谱主调整成员角色/分支/期限，或轮换加入码",
  "handler": "index.handler",
  "memorySize": 500,
  "timeout": 30,
  "triggers": [
    {
      "type": "http",
      "properties": {
        "enableUrlDecode": true,
        "authFlag": "true",
        "authAlgor": "HDA-SYSTEM",
        "authType": "apigw-client",
        "methods": [
          "POST"
        ]
      }
    }
  ]
}
