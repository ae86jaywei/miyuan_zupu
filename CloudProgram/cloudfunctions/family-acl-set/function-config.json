{
  "name": "family-acl-set",
  "version": "1.0.0",
  "description": "谱主调整成员角色/分支/期限，或轮换加入码",
  "memorySize": 500,
  "timeout": 30,
  "triggers": [
    {
      "type": "http",
      "properties": {
