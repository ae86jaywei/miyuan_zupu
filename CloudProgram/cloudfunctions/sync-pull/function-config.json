{
  "name": "sync-pull",
  "version": "1.0.0",
  "description": "家族内数据唯一读取通道（增量 / 全量基线）",
  "functionType": 1,
  "handler": "index.handler",
  "memorySize": 500,
  "timeout": 30,
  "triggers": [
    {
      "type": "http",
      "properties": {
        "enableUrlDecode": true,
        "authFlag": "true",
        "authAlgor": "HDA-SYSTEM",
        "authType": "apigw-client",
        "methods": [
          "POST"
        ]
      }
    }
  ]
}
