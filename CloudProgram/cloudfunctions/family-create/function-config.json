{
  "name": "family-create",
  "version": "1.0.0",
  "description": "创建家族（服务端生成 familyId / 加入码，写 Family + Membership(OWNER) + FamilyBook）",
  "handler": "index.handler",
  "memorySize": 500,
  "timeout": 30,
  "triggers": [
    {
      "type": "http",
      "properties": {
        "enableUrlDecode": true,
        "authFlag": "true",
        "authAlgor": "HDA-SYSTEM",
        "authType": "apigw-client",
        "methods": [
          "POST"
        ]
      }
    }
  ]
}
